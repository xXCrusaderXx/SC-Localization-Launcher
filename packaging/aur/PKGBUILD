# Maintainer: Marko Klein <55139200+xXCrusaderXx@users.noreply.github.com>
pkgname=sc-deutsch-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Deutsche Übersetzung für Star Citizen unter Linux"
arch=('x86_64')
url="https://github.com/xXCrusaderXx/StarCitizenDeutschLinux"
license=('GPL-3.0-or-later')
depends=('qt6-declarative' 'qt6-wayland' 'curl' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'nlohmann-json')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum when publishing a tag: updpkgsums
sha256sums=('SKIP')

build() {
    cmake -S "StarCitizenDeutschLinux-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSC_SYSTEM_INSTALL=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
