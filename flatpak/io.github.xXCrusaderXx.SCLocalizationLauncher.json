{
    "id": "io.github.xXCrusaderXx.SCLocalizationLauncher",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "sc-localization-launcher",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/cmake",
        "/share/pkgconfig"
    ],
    "modules": [
        {
            "name": "libsodium",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/jedisct1/libsodium/releases/download/1.0.22-RELEASE/libsodium-1.0.22.tar.gz",
                    "sha256": "adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349"
                }
            ],
            "cleanup": [
                "*.la"
            ]
        },
        {
            "name": "nlohmann-json",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DJSON_BuildTests=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/nlohmann/json/releases/download/v3.12.0/json.tar.xz",
                    "sha256": "42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa"
                }
            ]
        },
        {
            "name": "sc-localization-launcher",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DSC_SYSTEM_INSTALL=ON",
                "-DSC_INSTALL_SYSTEMD_UNITS=OFF"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        ".git",
                        ".cache",
                        ".flatpak-builder",
                        "build",
                        "build-appimage",
                        "build-flatpak",
                        "flatpak-out",
                        "release",
                        "misc/appimagetool-x86_64.appimage",
                        "misc/linuxdeploy-x86_64.appimage",
                        "misc/linuxdeploy-plugin-qt-x86_64.appimage"
                    ]
                }
            ]
        }
    ]
}
