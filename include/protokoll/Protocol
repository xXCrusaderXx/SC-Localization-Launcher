#pragma once
#include <nlohmann/json.hpp>
#include <string>

namespace Protocol
{

enum class MessageType
{
    ChannelRequest,
    ChannelResponse,
    SettingsRequest,
    SettingsResponse,
};

inline std::string toString (MessageType type)
{
    switch(type)
    {
        case MessageType::ChannelRequest:
            return "ChannelRequest";
        case MessageType::ChannelResponse:
            return "ChannelResponse";
        case MessageType::SettingsRequest:
            return "settingsRequest";
        case MessageType::SettingsResponse:
            return "settingsResponse";
    }
    return "unknown";
}

struct Message
{
    MessageType type;
    nlohmann::json payload;
    std::string status = "ok";
    std::string message;

    nlohmann::json toJson () const
    {
        nlohmann::json j;
        j["type"] = toString(type);
        j["status"] = status;
        j["payload"] = payload;
        if(!message.empty()) j["message"] = message;
        j["protocolVersion"] = 1;
        return j;
    }

    static Message fromJson (const nlohmann::json& j)
    {
        Message m;
        // ... parse type, status, payload, message, protocolVersion
        // (Fehlerbehandlung nicht vergessen)
        return m;
    }
};

}  // namespace Protocol
